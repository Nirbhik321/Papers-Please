# Copy to .env for local overrides. Everything is optional locally:
# with nothing set, the API uses data/app.db (SQLite) and data/storage/.

# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_BUCKET=uploads

# Moderation: a shared token (local) and/or Supabase users listed here
ADMIN_TOKEN=change-me-to-a-long-random-string
# ADMIN_EMAILS=you@example.com

# Upload protection
# TURNSTILE_SECRET_KEY=
# MAX_UPLOAD_MB=10
# MAX_PAGES=6
# UPLOADS_PER_HOUR=10
# IP_HASH_SALT=

# Website
CORS_ORIGINS=http://localhost:3000
# REVALIDATE_URL=http://localhost:3000/api/revalidate
# REVALIDATE_SECRET=
