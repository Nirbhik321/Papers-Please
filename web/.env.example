# Copy to .env.local for local development.

# The Papers Please API (Render in production)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional server-only URL for rendering pages (defaults to NEXT_PUBLIC_API_URL)
# API_URL=

# Shared with the API's REVALIDATE_SECRET so it can refresh pages after publishing
REVALIDATE_SECRET=change-me

# Cloudflare Turnstile site key (leave empty locally to skip the human check)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Supabase Auth for moderators (leave empty to sign in with the API's ADMIN_TOKEN)
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   (publishable key, sb_publishable_…)
